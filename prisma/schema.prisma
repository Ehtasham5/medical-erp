generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIVED
  SALE
  DAMAGED
  EXPIRED
  CORRECTION
  RETURN
}

enum SaleStatus {
  HELD
  COMPLETED
  CANCELLED
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  INVENTORY_STAFF
}

model Branch {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  isDefault          Boolean             @default(false)
  address            String?
  phone              String?
  currency           String              @default("USD")
  receiptHeader      String?
  receiptFooter      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  medicines          Medicine[]
  sales              Sale[]
  staffMembers       StaffMember[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
}

model StaffMember {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  branchId    String
  role        StaffRole @default(CASHIER)
  isActive    Boolean   @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])
  sales       Sale[]

  @@index([branchId])
  @@unique([clerkUserId, branchId])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  medicines   Medicine[]

  @@index([name])
}

model Medicine {
  id                 String              @id @default(cuid())
  branchId           String
  supplierId         String?
  name               String
  genericName        String?
  batchNumber        String
  price              Decimal             @db.Decimal(12, 2)
  costPrice          Decimal             @db.Decimal(12, 2)
  stockQuantity      Int
  reorderLevel       Int                 @default(20)
  expiryDate         DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branch             Branch              @relation(fields: [branchId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]

  @@unique([name, batchNumber, branchId])
  @@index([branchId, name])
  @@index([branchId, expiryDate])
  @@index([branchId, stockQuantity])
  @@index([supplierId])
}

model Sale {
  id            String      @id @default(cuid())
  branchId      String
  totalAmount   Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod String
  paymentDetails Json?
  status        SaleStatus @default(COMPLETED)
  receiptNumber String?    @unique
  requestId     String?    @unique
  createdAt     DateTime    @default(now())
  cashierId     String
  branch        Branch      @relation(fields: [branchId], references: [id])
  cashier       StaffMember @relation(fields: [cashierId], references: [clerkUserId])
  items         SaleItem[]

  @@index([branchId, createdAt])
  @@index([cashierId])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  medicineId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  branchId    String
  medicineId  String
  type        InventoryMovementType
  quantity    Int
  reason      String
  referenceId String?
  actorId     String?
  createdAt   DateTime              @default(now())
  branch      Branch                @relation(fields: [branchId], references: [id])
  medicine    Medicine              @relation(fields: [medicineId], references: [id])

  @@index([branchId, createdAt])
  @@index([medicineId, createdAt])
  @@index([referenceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  branchId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@index([entityType, entityId])
}
